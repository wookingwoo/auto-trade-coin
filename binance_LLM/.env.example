APP_NAME=auto-trade-coin
APP_ENV=development
LOG_LEVEL=INFO

TRADING_MODE=dry_run
TRADING_SYMBOLS=BTCUSDT
BINANCE_BASE_URL=https://fapi.binance.com
BINANCE_API_KEY=
BINANCE_API_SECRET=
DEFAULT_LEVERAGE=2
MAX_LEVERAGE=3
MAX_POSITION_SIZE_PCT=0.10
PAPER_STARTING_BALANCE=10000
ENABLE_PROTECTIVE_ORDERS=true
PROTECTIVE_ORDER_WORKING_TYPE=MARK_PRICE
REQUIRE_PROTECTIVE_ORDER_PARAMS=true
MIN_DECISION_CONFIDENCE=0.55
MAX_STOP_LOSS_PCT=0.05
MAX_TAKE_PROFIT_PCT=0.20
MAX_CONSECUTIVE_LOSSES=3
LIVE_TRADING_ACK=false

MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=auto_trade_coin

LLM_PROVIDER=openai
LLM_MODEL=gpt-4.1-mini
LLM_TEMPERATURE=0
LLM_MAX_RETRIES=2
OPENAI_API_KEY=

LANGSMITH_API_KEY=
LANGSMITH_PROJECT=auto-trade-coin
LANGSMITH_TRACING=false

NEWS_HEADLINE_LIMIT=5
NEWS_RSS_URLS=https://www.coindesk.com/arc/outboundfeeds/rss/,https://cointelegraph.com/rss
FEAR_GREED_API_URL=https://api.alternative.me/fng/?limit=1
DECISION_HISTORY_LIMIT=5
RUN_INTERVAL_MINUTES=60
